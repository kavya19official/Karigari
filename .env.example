# Karigari: environment variables
# ------------------------------------------------------------
# 1. Copy this file to .env.local   (never commit .env.local)
# 2. Fill in the values below, then restart `npm run dev`

# --- Supabase (REQUIRED) ---
# Supabase dashboard -> click "Connect" (or Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. NEVER share it, commit it, or prefix it with NEXT_PUBLIC_.
# Sign-up and sign-in need it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI agents (needed for /agents) ---
# Free key from https://aistudio.google.com  (do NOT prefix with NEXT_PUBLIC_:
# anything starting with NEXT_PUBLIC_ can be read by anyone in the browser)
GEMINI_API_KEY=your-gemini-api-key
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# --- Optional features ---
# GOOGLE_TRANSLATE_API_KEY=
# CREATOMATE_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Only when deploying (Vercel) ---
# Add the same variables under Project -> Settings -> Environment Variables, plus:
# CRON_SECRET=any-long-random-string     (without it the cron endpoints are open to anyone)
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing one.
