# Karigari - Environment variables for local development
# ------------------------------------------------------------
# 1. Copy this file to .env.local  (do NOT commit .env.local)
# 2. Create a free project at https://supabase.com
# 3. Paste the values from Project Settings → API
# 4. Run supabase/schema.sql in the Supabase SQL Editor
# 5. npm install && npm run dev

# Required (public – safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required only for server-side / admin operations (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# GOOGLE_GENERATIVE_AI_API_KEY=
